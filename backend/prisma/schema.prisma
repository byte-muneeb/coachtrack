// CoachTrack Pro — Prisma schema (MS SQL Server).
// Models are added page-by-page as each feature is made functional.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Student {
  id               Int       @id @default(autoincrement())
  registryId       String    @unique
  fullName         String
  email            String?
  phone            String?
  dateOfBirth      DateTime?
  address          String?
  guardianName     String?
  guardianRelation String?
  photoUrl         String?
  course           String?
  batch            String?
  commencementDate DateTime?
  status           String    @default("active") // active | pending | graduated | suspended
  discountPct      Float     @default(0)
  scholarship      Float     @default(0)
  totalFee         Float     @default(0)
  outstanding      Float     @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
