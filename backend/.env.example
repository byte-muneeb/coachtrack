# ---- CoachTrack backend configuration ----

# HTTP port for LOCAL dev only. On Vercel this is ignored (serverless).
PORT=4000

# ---- Database: Postgres / Supabase (ACTIVE) ----
# The app now runs on Postgres. Set DATABASE_URL to your Supabase connection
# string. Use the *Connection Pooling* string (Supabase → Project Settings →
# Database → Connection string → "Transaction" pooler, port 6543) — it's the one
# that works from serverless (Vercel) functions. SSL is required and on by default.
#   Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For a LOCAL, non-SSL Postgres instead of Supabase, leave DATABASE_URL unset and
# use PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD, plus PGSSL=disable.
# PGSSL=disable

# ---- SQL Server / Azure SQL (mssql) — FALLBACK ONLY ----
# The mssql code path is preserved (see _backups/coachtrack-mssql-backend-backup.zip)
# but is NOT used while DATABASE_URL / PG* are set. Kept for reference.
# DB_SERVER=your-server.database.windows.net
# DB_PORT=1433
# DB_NAME=coachtrack
# DB_USER=coachtrack_app
# DB_PASSWORD=change-me

# ---- Auth ----
# Secret used to sign session tokens (HMAC-SHA256). Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Vercel Cron ----
# Shared secret for the monthly auto-generation endpoint. Set the SAME value in
# Vercel; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". The
# endpoint FAILS CLOSED — if CRON_SECRET is unset it returns 503 and won't run.
CRON_SECRET=change-me-to-a-long-random-string

# ---- CORS ----
# Comma-separated allow-list of frontend origins permitted to call the API.
# If unset, all origins are allowed (local dev only) — ALWAYS set this in production.
#   CORS_ORIGIN=https://your-frontend.vercel.app
# CORS_ORIGIN=https://coachingfront.vercel.app
