# ---- CoachTrack backend configuration ----

# HTTP port for LOCAL dev only. On Vercel this is ignored (serverless).
PORT=4000

# ---- SQL Server / Azure SQL (mssql) connection ----
# Local SQL Server:   DB_SERVER=localhost
# Azure SQL Database: DB_SERVER=your-server.database.windows.net  (port 1433, encrypt on)
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=coachtrack
DB_USER=coachtrack_app
DB_PASSWORD=change-me

# ---- Auth ----
# Secret used to sign session tokens (HMAC-SHA256). Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Vercel Cron ----
# Shared secret for the monthly auto-generation endpoint. Set the SAME value in
# Vercel; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". If unset,
# the endpoint is unprotected (fine for local, NOT for production).
CRON_SECRET=change-me-to-a-long-random-string

# ---- CORS (optional) ----
# The API currently allows all origins (app.ts uses cors()). For production,
# restrict it to your Vercel frontend URL in backend/src/app.ts.
# CORS_ORIGIN=https://your-app.vercel.app
