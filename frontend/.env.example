# Base URL of the CoachTrack backend API (no trailing slash).
# This is a NEXT_PUBLIC_ var: it is inlined into the browser bundle AT BUILD TIME,
# so it must be set in Vercel (Production/Preview env) BEFORE the build runs.
#
# Local dev:   http://localhost:4000
# Production:  https://your-backend-host.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000
